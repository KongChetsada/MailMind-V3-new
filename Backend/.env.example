PORT=5000
FRONTEND_URL=http://localhost:3000

# Google Cloud Console → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ต้องตั้งทั้งสองค่า เซิร์ฟเวอร์จะไม่เริ่มทำงานถ้าว่าง
JWT_SECRET=
ENCRYPTION_SECRET=

# ตรงกับ docker-compose.yml
DATABASE_URL="postgresql://mailmind_user:mailmind_password@localhost:5432/mailmind_db?schema=public"

# Local AI (Ollama)
LOCAL_AI_BASE_URL="http://localhost:11434/v1"
LOCAL_AI_MODEL="llama3.1:8b"

# งานเบื้องหลัง
SYNC_CRON="*/10 * * * *"
INITIAL_SYNC_DAYS=7
SYNC_MAX_MESSAGES=300
ANALYZE_CONCURRENCY=1
ANALYZE_MAX_ATTEMPTS=3
JOBS_ENABLED=true

# Log: ใช้ LOG_LEVEL=debug คู่กับ LOG_SENSITIVE_CONTENT=true เฉพาะตอนดีบักในเครื่อง
LOG_LEVEL=info
LOG_SENSITIVE_CONTENT=false

# โหมดสาธิต: ใช้อีเมลตัวอย่างแทน Gmail (ไม่ต้องมี Google credentials) — ห้ามเปิดในระบบที่ใช้งานจริง
DEMO_MODE=false

# จำนวนการเชื่อมต่อฐานข้อมูลสูงสุด — ตั้งเป็น 1 เมื่อใช้ฐานข้อมูลทดสอบจาก `npx prisma dev`
# DB_POOL_MAX=1
