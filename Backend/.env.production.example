# Template only. Enter real values in Railway Variables, never commit secrets.
NODE_ENV=production
# Railway provides PORT. Do not set a fixed port unless required.
FRONTEND_URL=https://YOUR-FRONTEND.vercel.app
# Reference the Railway PostgreSQL service's DATABASE_URL in the dashboard.
DATABASE_URL=
DB_POOL_MAX=5

# Generate separate random secrets (at least 32 characters each).
# Preserve ENCRYPTION_SECRET across redeployments or stored credentials become unreadable.
JWT_SECRET=
ENCRYPTION_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-BACKEND.up.railway.app/api/auth/google/callback

DEMO_MODE=false
LOG_LEVEL=info
LOG_SENSITIVE_CONTENT=false
JOBS_ENABLED=true
SYNC_CRON="*/10 * * * *"
INITIAL_SYNC_DAYS=7
SYNC_MAX_MESSAGES=300
ANALYZE_CONCURRENCY=1
ANALYZE_MAX_ATTEMPTS=3

# Do not use localhost for Ollama on Railway.
# Prefer saving a Cloud AI key and choosing a provider in each user's Settings.
# LOCAL_AI_BASE_URL=https://YOUR-REACHABLE-OLLAMA/v1
# LOCAL_AI_MODEL=llama3.1:8b
