{
  "name": "mailmind-backend",
  "version": "3.0.0",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "main": "server.js",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "prisma migrate deploy && node server.js",
    "test": "node --test --test-isolation=none",
    "test:db": "node --env-file=.env --test --test-isolation=none dbtest/workflows.js",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "seed:demo": "node scripts/seed-demo.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.1",
    "@prisma/client": "^7.4.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.2.1",
    "openai": "^6.27.0",
    "pg": "^8.18.0",
    "prisma": "^7.4.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0"
  }
}
